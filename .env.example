# MySQL root 密码
# ⚠ 必须与 deploy/shardingsphere-jdbc.yml 里的 password 保持一致
MYSQL_ROOT_PASSWORD=novelplus2026

# Redis 密码
REDIS_PASSWORD=moyue2026

# 可选：镜像仓库前缀与标签
# 默认指向 ghcr.io/wwwwsddafa/novel-springboot，一般无需修改；
# 想换到自己的 registry 或锁定版本时再打开。
